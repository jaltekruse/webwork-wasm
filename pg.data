##########################
# Access methods
##########################

sub xmin {
	my $self = shift;
	my $type = ref($self) || die "$self is not an object";
	unless (exists $self->{xmin}) {
		die "Can't find xmin field in object of class $type";
	}

	if (@_) {
		return $self->{xmin} = shift;
	} else {
		return $self->{xmin};
	}
}

