	$main::APOS             = APOS();
	@main::ALPHABET         = ('A'..'ZZ');
	%main::STICKY_ANSWERS   = ();

EndOfFile

	# Next we transfer the correct definitions in the main:: compartment to the local my variables
	# This can't be done inside the eval above because my variables seem to be invisible inside the eval

	$PAR              = PAR();
	$BR               = BR();
	$BRBR             = BRBR();
	$LQ               = LQ();
	$RQ               = RQ();
	$BM               = BM();
	$EM               = EM();
	$BDM              = BDM();
	$EDM              = EDM();
	$LTS              = LTS();
	$GTS              = GTS();
	$LTE              = LTE();
	$GTE              = GTE();
	$BEGIN_ONE_COLUMN = BEGIN_ONE_COLUMN();
	$END_ONE_COLUMN   = END_ONE_COLUMN();
	$SOL              = SOLUTION_HEADING();
	$SOLUTION         = SOLUTION_HEADING();
	$HINT             = HINT_HEADING();
	$US               = US();
	$SPACE            = SPACE();
	$NBSP             = NBSP();
	$NDASH            = NDASH();
	$MDASH            = MDASH();
	$BLABEL           = BLABEL();
	$ELABEL           = ELABEL();
	$BBOLD            = BBOLD();
	$EBOLD            = EBOLD();
	$BITALIC          = BITALIC();
	$EITALIC          = EITALIC();
	$BUL              = BUL();
	$EUL              = EUL();
	$BCENTER          = BCENTER();
	$ECENTER          = ECENTER();
	$BLTR             = BLTR();
	$ELTR             = ELTR();
	$BKBD             = BKBD();
	$EKBD             = EKBD();
	$HR               = HR();
	$LBRACE           = LBRACE();
	$RBRACE           = RBRACE();
	$LB               = LB();
	$RB               = RB();
	$DOLLAR           = DOLLAR();
	$PERCENT          = PERCENT();
