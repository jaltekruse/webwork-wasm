	$main::BCENTER          = BCENTER();
	$main::ECENTER          = ECENTER();
	$main::BLTR             = BLTR();
	$main::ELTR             = ELTR();
	$main::BKBD             = BKBD();
	$main::EKBD             = EKBD();
	$main::HR               = HR();
