@namespronouns = (
	[ Adeline    => 'she' ],
	[ Aiden      => 'they' ],
	[ Alan       => 'he' ],
	[ Alana      => 'she' ],
	[ Alayna     => 'she' ],
	[ Alec       => 'they' ],
	[ Alessandro => 'he' ],
	[ Alex       => 'he' ],
	[ Alexa      => 'she' ],
	[ Alexia     => 'she' ],
	[ Alia       => 'she' ],
	[ Allison    => 'she' ],
	[ Allyson    => 'she' ],
	[ Alyson     => 'she' ],
	[ Alyssa     => 'she' ],
	[ Amelia     => 'she' ],
	[ Amira      => 'she' ],
	[ Amiyah     => 'she' ],
	[ Annika     => 'she' ],
	[ Aracely    => 'she' ],
	[ Arnav      => 'he' ],
	[ Arturo     => 'he' ],
	[ Aryana     => 'she' ],
