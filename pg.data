sub TeXGreek {
	my $greek = shift;
	my $uc    = shift;
	push(@_, TeX => "{\\rm $uc}") if $uc;
	return ($greek => { value => Real(1), TeX => "\\$greek ", keepName => 1, @_ });
}

sub TeXord {
	my $name = shift;
	my $tex  = shift;
	$tex = "\\$name " unless defined $tex;
	$tex .= ' ' if $tex =~ m/\\[a-zA-Z]+$/;
	return ($name => { value => Real(1), TeX => $tex, keepName => 1, @_ });
}

sub TeXconst {
	my $name = shift;
	my $tex  = shift;
	$tex .= " " unless $tex =~ m/}$/;
	my $string = shift;
	$string = $name unless defined $string;
	return ($name => { value => Real(1), TeX => $tex, string => $string, keepName => 1, @_ });
}

