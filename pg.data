######################################

sub GRnoneuler_size {
	my ($size) = @_;

	my ($i, @ans, @deg, $pic, $diff, $graph, @lowdeg);

	for ($i = 0; $i < $size; $i++) {
		push @lowdeg, 2;
	}

	@ans = (1, '');

	#   while ($graph eq 'DNE' || $ans == 1){
