package parser::AutoStrings;
our @ISA = ("Value::String");

sub new {
	my $self    = shift;
	my $class   = ref($self) || $self;
	my $context = (Value::isContext($_[0]) ? shift : $self->context);
	my $x       = join('', @_);
	$context->strings->add($x => {}) unless defined $context->{strings}{$x};
	$self->SUPER::new($x);
}

